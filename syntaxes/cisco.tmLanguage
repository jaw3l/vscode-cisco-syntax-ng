<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>fileTypes</key>
	<array>
		<string>ios</string>
	</array>
	<key>foldingStartMarker</key>
	<string>^interface|^router|^ip access-list extended</string>
	<key>foldingStopMarker</key>
	<string>^!</string>
	<key>name</key>
	<string>Cisco</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>match</key>
			<string>^\s*no </string>
			<key>name</key>
			<string>invalid.illegal.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>access-list</string>
			<key>name</key>
			<string>support.function.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>crypto </string>
			<key>name</key>
			<string>string.unquoted.cisco</string>
		</dict>
		<dict>
			<key>begin</key>
                        <string>\^C</string>
			<key>end</key>
                        <string>\^C</string>
			<key>name</key>
			<string>string.quoted.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>any[46]? </string>
			<key>name</key>
			<string>string.unquoted.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>deny </string>
			<key>name</key>
			<string>support.constant.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>permit </string>
			<key>name</key>
			<string>constant.character.escape.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>object-group</string>
			<key>name</key>
			<string>markup.list.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>object</string>
			<key>name</key>
			<string>markup.list.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>host</string>
			<key>name</key>
			<string>markup.list.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>^[\s]*!(.*)</string>
			<key>name</key>
			<string>comment.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>static</string>
			<key>name</key>
			<string>constant.numeric.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>tunnel-group</string>
			<key>name</key>
			<string>support.class.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>crypto</string>
			<key>name</key>
			<string>support.class.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\d+\.\d+\.\d+\.\d+(/\d{1,2})?</string>
			<key>name</key>
			<string>constant.numeric.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>[0-9a-fA-F]{0,4}:([0-9a-fA-F]{0,4}:)+[0-9a-fA-F]{0,4}(/\d{1,3})?</string>
			<key>name</key>
			<string>constant.numeric.cisco</string>
		</dict>
		<!--Added new matches from https://github.com/jasongill/cisco-ios-tmbundle -->
		<dict>
			<key>match</key>
			<string>(\bshutdown\b|^boot-(start|end)-marker)</string>
			<key>name</key>
			<string>invalid.illegal.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>((^$|no )(interface|line|ip (access-list (extended|standard)|dhcp (pool|excluded-address)|route|classless|subnet-zero|nat|http|local pool|flow-export|flow-top-talkers|inspect|domain|ips|host)|router|voice-(card|port)|dial-peer|voice (translation-(rule|profile)|register (global|pool|dn)|service)|application$|crypto (pki|keyring|isakmp (profile|policy|client configuration)|ipsec (profile|transform-set)|(dynamic-)?map)|telephony-service|ephone(-dn)?|banner|(class|policy|route)-map|map-class)|\b(ssid|pvc|certificate)|service|clock|boot|logging|control-plane|aaa|(tftp|snmp|radius)-server|ntp|bridge|(access|dialer)-list|archive)\b</string>
			<key>name</key>
			<string>support.control.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|\h{1,4}\.\h{1,4}\.\h{1,4}(\.\h{1,2})?)\b</string>
			<key>name</key>
			<string>constant.numeric.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b((Fast|Gigabit|TenGigabit|FortyGigabit)?Ethernet|Dialer|Dot11Radio|ATM|BRI|Tunnel(Group-)?Async|BVI|[Ll]oopback|Null|[Pp]ort-channel|Virtual-(Access|Dot11Radio|PPP|Template)|TenGigE|TwentyFiveGigE|HundredGigE|tunnel-ip|Bundle-Ether|MgmtEth0)</string>
			<key>name</key>
			<string>constant.language.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\binterface</string>
			<key>name</key>
			<string>constant.language.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>^!.*$</string>
			<key>name</key>
			<string>comment.bang.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(description|remark|system message)\s.*$</string>
			<key>name</key>
			<string>comment.documentation.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\bno\b</string>
			<key>name</key>
			<string>constant.language.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>^version.*$</string>
			<key>name</key>
			<string>constant.language.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>^(username|hostname|enable)\b</string>
			<key>name</key>
			<string>keyword.other.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(network|passive-interface|redistribute|auto-summary|synchronization|bgp|neighbor|default-information)\b</string>
			<key>name</key>
			<string>keyword.other.routing.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(ip (address|unnumbered|proxy-arp|nat|nbar|virtual-reassembly|access-group|verify)|speed|(full-|half-)?duplex|cdp enable|encapsulation|dialer(-group)?|compress|ppp|crypto|channel|station-role|encryption|broadcast-key|snmp|isdn|dsl|tunnel|bandwidth|fair-queue|physical-layer|async mode|peer default|switchport|media-type|clockrate)\b</string>
			<key>name</key>
			<string>keyword.other.interface.cisco</string>
		</dict>
		<!-- IOS-XR specific commands -->
		<dict>
			<key>match</key>
			<string>\b(ipv(4|6) (address|address-family|unnumbered|proxy-arp|nat|nbar|virtual-reassembly|access-group|verify)|speed|(full-|half-)?duplex|cdp enable|encapsulation|dialer(-group)?|compress|ppp|crypto|channel|station-role|encryption|broadcast-key|snmp|isdn|dsl|tunnel|bandwidth|fair-queue|physical-layer|async mode|peer default|switchport|media-type|clockrate|bundle|vrf|mtu|lacp|bfd)\b</string>
			<key>name</key>
			<string>keyword.control.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b((session|exec)-timeout|login|password|stopbits|access-class|transport (input|output))\b</string>
			<key>name</key>
			<string>keyword.other.line.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(domain-name|default-router|dns-server|host|client-(name|identifier)|option)\b</string>
			<key>name</key>
			<string>keyword.other.dhcp.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\baddress-family\b</string>
			<key>name</key>
			<string>constant.language.address-family.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(device-security-mode|mac-address|type|button|video|username)\b</string>
			<key>name</key>
			<string>keyword.other.ephone.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(number|name|call-forward|hold-alert)\b</string>
			<key>name</key>
			<string>keyword.other.ephonedn.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(load|max-ephones|max-dn|ip|auto|calling-number|timeouts|time-zone|time-format|date-format|dialplan-pattern|max-conferences|moh|web|(dn|time)-webedit|transfer-(system|pattern)|create)\b</string>
			<key>name</key>
			<string>keyword.other.telephony.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(translation-profile|answer-address|destination-pattern|progress_ind|incoming|direct-inward-dial|port|max-conn|information-type|session (target|protocol)|dtmf-relay|codec|vad)\b</string>
			<key>name</key>
			<string>keyword.other.dial-peer.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(compand-type|comfort-noise|cptone)\b</string>
			<key>name</key>
			<string>keyword.other.voice-port.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(permit|deny|log|established|evaluate)\b</string>
			<key>name</key>
			<string>keyword.other.acl.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(auth(entic|oriz)ation|accounting)\b</string>
			<key>name</key>
			<string>keyword.other.aaa.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\bmatch (ip precedence|protocol|access-group)\b</string>
			<key>name</key>
			<string>keyword.other.class-map.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(class(-default)?|set ip dscp|priority)\b</string>
			<key>name</key>
			<string>keyword.other.policy-map.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(frame-relay|service-policy)\b</string>
			<key>name</key>
			<string>keyword.other.map-class.cisco</string>
		</dict>
		<!-- VLAN and VTP commands -->
		<dict>
			<key>match</key>
			<string>\bvlan(-configuration|(-edit|-filter))?\b</string>
			<key>name</key>
			<string>support.control.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(vlan|remote-span|private-vlan)\b</string>
			<key>name</key>
			<string>constant.language.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(name|state|suspend|resume|mtu|said|stp|mode)\b</string>
			<key>name</key>
			<string>keyword.other.vlan.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(primary|isolated|community|association|secondary)\b</string>
			<key>name</key>
			<string>keyword.other.private-vlan.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\bvtp\b</string>
			<key>name</key>
			<string>constant.language.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(mode|domain|version|password|pruning)\b</string>
			<key>name</key>
			<string>keyword.other.vtp.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(server|client|transparent|off)\b</string>
			<key>name</key>
			<string>keyword.other.vtp.cisco</string>
		</dict>
		<!-- Switchport commands -->
		<dict>
			<key>match</key>
			<string>\bswitchport\b</string>
			<key>name</key>
			<string>constant.language.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\bmode (access|trunk|dynamic (auto|desirable)|dot1q-tunnel)\b</string>
			<key>name</key>
			<string>keyword.other.switchport.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\baccess (vlan|voice)\b</string>
			<key>name</key>
			<string>keyword.other.switchport.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\btrunk (encapsulation|allowed|native|pruning)\b</string>
			<key>name</key>
			<string>keyword.other.switchport.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(nonegotiate|block|auto|negotiate)\b</string>
			<key>name</key>
			<string>keyword.other.switchport.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\bvoice (vlan|dot1p|priority)\b</string>
			<key>name</key>
			<string>keyword.other.switchport.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(host-mode|protected)\b</string>
			<key>name</key>
			<string>keyword.other.switchport.cisco</string>
		</dict>
		<!-- VLAN interface / SVI -->
		<dict>
			<key>match</key>
			<string>\bautostate\b</string>
			<key>name</key>
			<string>keyword.other.vlan.cisco</string>
		</dict>
		<!-- STP keywords -->
		<dict>
			<key>match</key>
			<string>\bspanning-tree\b</string>
			<key>name</key>
			<string>constant.language.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\bspanning-tree (vlan|mst|extend|mode|guard|portfast|link-type|bpduguard|bpdufilter|backbonefast|uplinkfast|cost|priority|root|hello-time|forward-time|max-age|transmit-hold-count|pathcost)\b</string>
			<key>name</key>
			<string>keyword.other.stp.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\bspanning-tree mode (pvst|rapid-pvst|mst)\b</string>
			<key>name</key>
			<string>keyword.other.stp.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(root (primary|secondary)|port (priority|fast))\b</string>
			<key>name</key>
			<string>keyword.other.stp.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(stp|rstp|mstp|pvst|rapid-pvst)\b</string>
			<key>name</key>
			<string>keyword.other.stp.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(guard (loop|root|none)|portfast (default|bpduguard|bpdufilter))\b</string>
			<key>name</key>
			<string>keyword.other.stp.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(loopguard|loop-guard)$</string>
			<key>name</key>
			<string>keyword.other.stp.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\blink-type (auto|point-to-point|shared)\b</string>
			<key>name</key>
			<string>keyword.other.stp.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(pvst|rapid-pvst|mst)\b</string>
			<key>name</key>
			<string>keyword.other.stp.cisco</string>
		</dict>
		<!-- MST (Multiple Spanning Tree) -->
		<dict>
			<key>match</key>
			<string>\binstance (\d+) vlan (\d+[\d,-]*)\b</string>
			<key>name</key>
			<string>keyword.other.mst.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(region|name|revision|max-hops)\b</string>
			<key>name</key>
			<string>keyword.other.mst.cisco</string>
		</dict>
		<!-- UDLD -->
		<dict>
			<key>match</key>
			<string>\budld (enable|disable|aggressive)\b</string>
			<key>name</key>
			<string>keyword.other.interface.cisco</string>
		</dict>
		<!-- Storm Control -->
		<dict>
			<key>match</key>
			<string>\bstorm-control (broadcast|multicast|unicast) (level|pps)\b</string>
			<key>name</key>
			<string>keyword.other.interface.cisco</string>
		</dict>
		<!-- Errdisable -->
		<dict>
			<key>match</key>
			<string>\berrdisable (recovery (cause|interval)|detect cause)\b</string>
			<key>name</key>
			<string>keyword.other.cisco</string>
		</dict>
		<!-- SVI (Switched Virtual Interface) and Routed Port -->
		<dict>
			<key>match</key>
			<string>\b(ip (routing|default-gateway|default-network|directed-broadcast|redirects|unreachables|igmp-helper-address|split-horizon|local-proxy-arp|proxy-arp| gratuitous-arp|route-cache))\b</string>
			<key>name</key>
			<string>keyword.other.svi.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(ip helper-address)\b</string>
			<key>name</key>
			<string>keyword.other.svi.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(ip (nat (inside|outside)| virtual-reassembly| tcp-adjust-mss))\b</string>
			<key>name</key>
			<string>keyword.other.svi.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(ip pim (sparse-mode|dense-mode|sparse-dense-mode|neighbor-filter|passive|dr-priority))\b</string>
			<key>name</key>
			<string>keyword.other.svi.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(ip virtual-router mac-address)\b</string>
			<key>name</key>
			<string>keyword.other.svi.cisco</string>
		</dict>
		<!-- HSRP (Hot Standby Router Protocol) -->
		<dict>
			<key>match</key>
			<string>\bstandby\b</string>
			<key>name</key>
			<string>constant.language.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\bstandby (version|timers|priority|preempt|ip|name|track|authentication|mac-address|msec|delay (minimum|reload))\b</string>
			<key>name</key>
			<string>keyword.other.hsrp.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(active|standby|listen|init)\b</string>
			<key>name</key>
			<string>keyword.other.hsrp.cisco</string>
		</dict>
		<!-- VRRP (Virtual Router Redundancy Protocol) -->
		<dict>
			<key>match</key>
			<string>\bvrrp\b</string>
			<key>name</key>
			<string>constant.language.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\bvrrp (version|timers|priority|preempt|ip|description|authentication|track|delay (reload))\b</string>
			<key>name</key>
			<string>keyword.other.vrrp.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(learn|master|backup|initialize)\b</string>
			<key>name</key>
			<string>keyword.other.vrrp.cisco</string>
		</dict>
		<!-- GLBP (Gateway Load Balancing Protocol) -->
		<dict>
			<key>match</key>
			<string>\bglbp\b</string>
			<key>name</key>
			<string>constant.language.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\bglbp (timers|priority|preempt|ip|name|weight|load-balancing|authentication|track|forwarder|mac-address)\b</string>
			<key>name</key>
			<string>keyword.other.glbp.cisco</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(round-robin|weighted|host-dependent)\b</string>
			<key>name</key>
			<string>keyword.other.glbp.cisco</string>
		</dict>
		<!-- Routed port (no switchport) -->
		<dict>
			<key>match</key>
			<string>\b(routed-port)\b</string>
			<key>name</key>
			<string>keyword.other.interface.cisco</string>
		</dict>
	</array>
	<key>scopeName</key>
	<string>text.cisco</string>
	<key>uuid</key>
	<string>f3ba50f0-2bad-48b7-9509-f6d72e353ddb</string>
</dict>
</plist>

